---
// A screenshot in both themes; Starlight hides the one that doesn't match.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  caption?: string;
  eager?: boolean;
}
const { light, dark, alt, caption, eager = false } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
---
<figure>
  <Image src={light} alt={alt} class="shot dark:sl-hidden" widths={[720, 1200, 1800]} sizes="(min-width: 72rem) 48rem, 100vw" loading={loading} />
  <Image src={dark} alt={alt} class="shot light:sl-hidden" widths={[720, 1200, 1800]} sizes="(min-width: 72rem) 48rem, 100vw" loading={loading} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
